# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is listed in .gitignore and will NEVER be committed to git.
# This .env.example file (with placeholder values) is safe to commit.

# --- Gmail SMTP credentials, used by the send_task_reminder_email tool ---
# This is the Gmail address the server will send reminder emails FROM.
GMAIL_ADDRESS=your_address@gmail.com

# A Gmail "App Password" (NOT your normal Gmail login password).
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (spaces don't matter).
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Local task database ---
# Path (relative to the project folder) where the SQLite task database lives.
TASKS_DB_PATH=tasks.db
